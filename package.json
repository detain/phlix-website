{
  "name": "phlix-website",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Marketing website for Phlix — self-hostable PHP media server with Roku, Tizen, Windows, and Mobile clients. One brand-themed site per brand kit (brand-kits/*.js -> sites/<slug>/) share content, differ in look-and-feel.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build": "node tools/build.mjs",
    "lint:html": "node tools/lint.mjs html",
    "lint:css": "node tools/lint.mjs css",
    "lint:js": "node tools/lint.mjs js",
    "lint": "run-p --continue-on-error --aggregate-output --print-name lint:html lint:css lint:js",
    "format": "node tools/lint.mjs format",
    "format:check": "node tools/lint.mjs format-check",
    "a11y": "node tools/a11y.mjs",
    "lhci": "lhci autorun",
    "linkcheck": "node tools/lint.mjs links",
    "meta": "node tools/check-meta.mjs",
    "kit-brief": "node tools/kit-brief.mjs",
    "selfcheck": "node tools/selfcheck.mjs",
    "render-check": "node tools/render-check.mjs",
    "og": "node tools/gen-og.mjs",
    "test:unit": "node --test \"test/**/*.test.mjs\"",
    "test": "npm-run-all -s test:unit lint linkcheck meta",
    "preview": "node tools/preview-all.mjs"
  },
  "keywords": [
    "phlix",
    "media-server",
    "streaming",
    "self-hosted",
    "landing-page",
    "marketing-site",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detain/phlix-website.git"
  },
  "bugs": {
    "url": "https://github.com/detain/phlix-server/issues"
  },
  "homepage": "https://detain.github.io/phlix-website/",
  "author": "Joe Huss <detain@interserver.net>",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.8.1",
    "glob": "^13.0.0",
    "globals": "^17.11.0",
    "google-fonts-helper": "^3.7.4",
    "htmlhint": "^1.1.4",
    "linkinator": "^8.1.0",
    "npm-run-all2": "^9.0.0",
    "pa11y-ci": "^4.1.1",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard": "^40.0.0",
    "ttf2woff2": "^8.0.1"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "tmp": "^0.2.5",
    "semver": "^7.8.0",
    "lodash": "^4.18.1",
    "external-editor": {
      "tmp": "^0.2.5"
    },
    "chrome-launcher": "^1.2.1",
    "rimraf": "^6.0.1",
    "glob": "^13.0.0",
    "globby": {
      "glob": "^7.2.3"
    },
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0",
    "@lhci/cli": {
      "uuid": "^11.1.1"
    },
    "puppeteer": "25.8.0",
    "puppeteer-core": "25.8.0"
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  }
}

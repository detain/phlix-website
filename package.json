{
  "name": "phlix-website",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Marketing website for Phlix — self-hostable PHP media server with Roku, Tizen, Windows, and Mobile clients. Five brand-themed variants share content, differ in look-and-feel.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "dev:01": "node tools/dev-server.mjs --variant 01-minimalist-cinema",
    "dev:02": "node tools/dev-server.mjs --variant 02-spotlight-projector",
    "dev:03": "node tools/dev-server.mjs --variant 03-retro-film-reel",
    "dev:04": "node tools/dev-server.mjs --variant 04-portal-hub",
    "dev:05": "node tools/dev-server.mjs --variant 05-pixel-tech",
    "build": "node tools/build.mjs",
    "lint:html": "node tools/lint.mjs html",
    "lint:css": "node tools/lint.mjs css",
    "lint:js": "node tools/lint.mjs js",
    "lint": "run-p lint:html lint:css lint:js",
    "format": "node tools/lint.mjs format",
    "format:check": "node tools/lint.mjs format-check",
    "a11y": "node tools/a11y.mjs",
    "lhci": "lhci autorun",
    "linkcheck": "node tools/lint.mjs links",
    "test": "npm-run-all -s lint linkcheck",
    "preview": "node tools/preview-all.mjs"
  },
  "keywords": [
    "phlix",
    "media-server",
    "streaming",
    "self-hosted",
    "landing-page",
    "marketing-site",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detain/phlix-website.git"
  },
  "bugs": {
    "url": "https://github.com/detain/phlix-website/issues"
  },
  "homepage": "https://detain.github.io/phlix-website/",
  "author": "Joe Huss <detain@interserver.net>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^9.0.0",
    "glob": "^13.0.0",
    "globals": "^15.0.0",
    "htmlhint": "^1.1.4",
    "linkinator": "^7.6.1",
    "npm-run-all2": "^9.0.0",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.3.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^36.0.0"
  },
  "overrides": {
    "cookie": "^1.0.2",
    "tmp": "^0.2.4",
    "semver": "^7.6.3",
    "lodash": "^4.17.21",
    "external-editor": {
      "tmp": "^0.2.4"
    },
    "chrome-launcher": "^1.2.1",
    "rimraf": "^6.0.1",
    "globby": "^11.1.0",
    "glob": "$glob"
  }
}

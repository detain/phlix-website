{
  "name": "phlix-website",
  "version": "0.1.0",
  "private": true,
  "description": "Marketing website for Phlix — self-hostable PHP media server with Roku, Tizen, Windows, and Mobile clients. Five brand-themed variants share content, differ in look-and-feel.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "dev:01": "node tools/dev-server.mjs --variant 01-minimalist-cinema",
    "dev:02": "node tools/dev-server.mjs --variant 02-spotlight-projector",
    "dev:03": "node tools/dev-server.mjs --variant 03-retro-film-reel",
    "dev:04": "node tools/dev-server.mjs --variant 04-portal-hub",
    "dev:05": "node tools/dev-server.mjs --variant 05-pixel-tech",
    "build": "node tools/build.mjs",
    "lint:html": "htmlhint 'variants/**/*.html'",
    "lint:css": "stylelint 'variants/**/*.css'",
    "lint:js": "eslint 'variants/**/*.js' 'tools/**/*.mjs'",
    "lint": "npm-run-all -p lint:html lint:css lint:js",
    "format": "prettier --write 'variants/**/*.{html,css,js}' 'shared/**/*.json' 'docs/**/*.md'",
    "a11y": "pa11y-ci --config .pa11yci.json",
    "lhci": "lhci autorun",
    "linkcheck": "linkinator 'variants/**/*.html' --recurse --silent",
    "test": "npm-run-all -s lint linkcheck",
    "preview": "node tools/preview-all.mjs"
  },
  "keywords": [
    "phlix",
    "media-server",
    "streaming",
    "self-hosted",
    "landing-page",
    "marketing-site",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detain/phlix-website.git"
  },
  "bugs": {
    "url": "https://github.com/detain/phlix-website/issues"
  },
  "homepage": "https://detain.github.io/phlix-website",
  "author": "Joe Huss <detain@interserver.net>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "eslint": "^9.0.0",
    "htmlhint": "^1.1.4",
    "linkinator": "^6.0.0",
    "npm-run-all": "^4.1.5",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.3.0",
    "stylelint": "^16.0.0",
    "stylelint-config-standard": "^36.0.0"
  }
}

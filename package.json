{
  "name": "phlix-website",
  "version": "0.2.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "description": "Marketing website for Phlix — self-hostable PHP media server with Roku, Tizen, Windows, and Mobile clients. 25 brand-themed variants (5 waves × 5 concepts) share content, differ in look-and-feel.",
  "type": "module",
  "scripts": {
    "dev": "node tools/dev-server.mjs",
    "build": "node tools/build.mjs",
    "lint:html": "node tools/lint.mjs html",
    "lint:css": "node tools/lint.mjs css",
    "lint:js": "node tools/lint.mjs js",
    "lint": "run-p lint:html lint:css lint:js",
    "format": "node tools/lint.mjs format",
    "format:check": "node tools/lint.mjs format-check",
    "a11y": "node tools/a11y.mjs",
    "lhci": "lhci autorun",
    "linkcheck": "node tools/lint.mjs links",
    "meta": "node tools/check-meta.mjs",
    "og": "node tools/gen-og.mjs",
    "test": "npm-run-all -s lint linkcheck meta",
    "preview": "node tools/preview-all.mjs",
    "dev:0101": "node tools/dev-server.mjs --variant 01-minimalist-cinema-1",
    "dev:0102": "node tools/dev-server.mjs --variant 01-minimalist-cinema-2",
    "dev:0103": "node tools/dev-server.mjs --variant 01-minimalist-cinema-3",
    "dev:0104": "node tools/dev-server.mjs --variant 01-minimalist-cinema-4",
    "dev:0105": "node tools/dev-server.mjs --variant 01-minimalist-cinema-5",
    "dev:0201": "node tools/dev-server.mjs --variant 02-spotlight-projector-1",
    "dev:0202": "node tools/dev-server.mjs --variant 02-spotlight-projector-2",
    "dev:0203": "node tools/dev-server.mjs --variant 02-spotlight-projector-3",
    "dev:0204": "node tools/dev-server.mjs --variant 02-spotlight-projector-4",
    "dev:0205": "node tools/dev-server.mjs --variant 02-spotlight-projector-5",
    "dev:0301": "node tools/dev-server.mjs --variant 03-retro-film-reel-1",
    "dev:0302": "node tools/dev-server.mjs --variant 03-retro-film-reel-2",
    "dev:0303": "node tools/dev-server.mjs --variant 03-retro-film-reel-3",
    "dev:0304": "node tools/dev-server.mjs --variant 03-retro-film-reel-4",
    "dev:0305": "node tools/dev-server.mjs --variant 03-retro-film-reel-5",
    "dev:0401": "node tools/dev-server.mjs --variant 04-portal-hub-1",
    "dev:0402": "node tools/dev-server.mjs --variant 04-portal-hub-2",
    "dev:0403": "node tools/dev-server.mjs --variant 04-portal-hub-3",
    "dev:0404": "node tools/dev-server.mjs --variant 04-portal-hub-4",
    "dev:0405": "node tools/dev-server.mjs --variant 04-portal-hub-5",
    "dev:0501": "node tools/dev-server.mjs --variant 05-pixel-tech-1",
    "dev:0502": "node tools/dev-server.mjs --variant 05-pixel-tech-2",
    "dev:0503": "node tools/dev-server.mjs --variant 05-pixel-tech-3",
    "dev:0504": "node tools/dev-server.mjs --variant 05-pixel-tech-4",
    "dev:0505": "node tools/dev-server.mjs --variant 05-pixel-tech-5",
    "build:wave1": "node tools/build.mjs --wave 1",
    "build:wave2": "node tools/build.mjs --wave 2",
    "build:wave3": "node tools/build.mjs --wave 3",
    "build:wave4": "node tools/build.mjs --wave 4",
    "build:wave5": "node tools/build.mjs --wave 5",
    "build:all": "node tools/build.mjs --wave all",
    "lint:wave1": "node tools/lint.mjs html --variants wave1 && node tools/lint.mjs css --variants wave1 && node tools/lint.mjs js --variants wave1",
    "preview:wave1": "node tools/preview-all.mjs --wave 1",
    "preview:wave2": "node tools/preview-all.mjs --wave 2",
    "preview:wave3": "node tools/preview-all.mjs --wave 3",
    "preview:wave4": "node tools/preview-all.mjs --wave 4",
    "preview:wave5": "node tools/preview-all.mjs --wave 5"
  },
  "keywords": [
    "phlix",
    "media-server",
    "streaming",
    "self-hosted",
    "landing-page",
    "marketing-site",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/detain/phlix-website.git"
  },
  "bugs": {
    "url": "https://github.com/detain/phlix-server/issues"
  },
  "homepage": "https://detain.github.io/phlix-website/",
  "author": "Joe Huss <detain@interserver.net>",
  "license": "BSD-3-Clause",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.15.1",
    "eslint": "^10.0.0",
    "glob": "^13.0.0",
    "globals": "^17.6.0",
    "htmlhint": "^1.1.4",
    "linkinator": "^7.6.1",
    "npm-run-all2": "^9.0.0",
    "pa11y-ci": "^4.1.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0"
  },
  "overrides": {
    "cookie": "^1.1.1",
    "tmp": "^0.2.5",
    "semver": "^7.8.0",
    "lodash": "^4.18.1",
    "external-editor": {
      "tmp": "^0.2.5"
    },
    "chrome-launcher": "^1.2.1",
    "rimraf": "^6.0.1",
    "glob": "^13.0.0",
    "js-yaml": "^4.2.0",
    "@opentelemetry/core": "^2.8.0",
    "@lhci/cli": {
      "uuid": "^11.1.1"
    }
  },
  "main": "eslint.config.js",
  "directories": {
    "doc": "docs"
  }
}

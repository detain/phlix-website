<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0d1b2a"/>
      <stop offset="100%" stop-color="#1b263b"/>
    </linearGradient>
    <radialGradient id="glow1" cx="30%" cy="40%" r="50%">
      <stop offset="0%" stop-color="#415a77" stop-opacity="0.4"/>
      <stop offset="100%" stop-color="#415a77" stop-opacity="0"/>
    </radialGradient>
    <radialGradient id="glow2" cx="70%" cy="60%" r="40%">
      <stop offset="0%" stop-color="#60a5fa" stop-opacity="0.3"/>
      <stop offset="100%" stop-color="#60a5fa" stop-opacity="0"/>
    </radialGradient>
  </defs>
  <!-- Background -->
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect width="1200" height="630" fill="url(#glow1)"/>
  <rect width="1200" height="630" fill="url(#glow2)"/>
  <!-- Orbit rings -->
  <ellipse cx="600" cy="315" rx="300" ry="100" fill="none" stroke="#415a77" stroke-width="1" opacity="0.5" transform="rotate(-30 600 315)"/>
  <ellipse cx="600" cy="315" rx="300" ry="100" fill="none" stroke="#415a77" stroke-width="1" opacity="0.5" transform="rotate(30 600 315)"/>
  <ellipse cx="600" cy="315" rx="300" ry="100" fill="none" stroke="#415a77" stroke-width="1" opacity="0.5"/>
  <!-- Nucleus -->
  <circle cx="600" cy="315" r="50" fill="#60a5fa" opacity="0.8"/>
  <circle cx="600" cy="315" r="30" fill="#415a77"/>
  <!-- Electrons -->
  <circle cx="600" cy="15" r="12" fill="#60a5fa">
    <animateTransform attributeName="transform" type="rotate" from="0 600 315" to="360 600 315" dur="8s" repeatCount="indefinite"/>
  </circle>
  <circle cx="600" cy="615" r="12" fill="#778da9">
    <animateTransform attributeName="transform" type="rotate" from="120 600 315" to="480 600 315" dur="8s" repeatCount="indefinite"/>
  </circle>
  <circle cx="885" cy="315" r="12" fill="#60a5fa">
    <animateTransform attributeName="transform" type="rotate" from="240 600 315" to="600 600 315" dur="8s" repeatCount="indefinite"/>
  </circle>
  <!-- Text -->
  <text x="600" y="500" text-anchor="middle" font-family="Consolas, monospace" font-size="48" font-weight="700" fill="#e0e1dd" letter-spacing="0.1em">PHLIX</text>
  <text x="600" y="550" text-anchor="middle" font-family="Consolas, monospace" font-size="24" fill="#778da9" letter-spacing="0.05em">Every Frame, Every State. Observed.</text>
</svg>
